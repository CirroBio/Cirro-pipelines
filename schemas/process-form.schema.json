{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Cirro process-form.json",
    "description": "Defines the form shown to users before a pipeline is run. See https://docs.cirro.bio/pipelines/configuring-pipeline/#manual-configuration",
    "type": "object",
    "required": ["form"],
    "additionalProperties": false,
    "properties": {
        "form": {
            "description": "JSONSchema of the form inputs.",
            "$ref": "http://json-schema.org/draft-07/schema#"
        },
        "ui": {
            "description": "Used to override the input components. https://react-jsonschema-form.readthedocs.io/en/docs/api-reference/uiSchema/.",
            "additionalProperties": true,
            "properties": {
                "ui:order": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "ui:field": {
                    "type": "string"
                },
                "ui:options": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "patternProperties": {
                "^(?!ui:order$)": {
                    "type": ["string", "object"]
                }
            }
        },
        "structuredInputs": {
            "description": "Definitions of structured input files (e.g. sample sheets), keyed by name. Form fields reference an entry by setting `schema` to its key.",
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/structuredInput"
            }
        }
    },
    "$defs": {
        "structuredInput": {
            "type": "object",
            "required": [
                "fileFormat",
                "schema"
            ],
            "additionalProperties": false,
            "properties": {
                "fileFormat": {
                    "description": "Format of the file passed to the workflow",
                    "enum": ["CSV", "TSV", "JSON"],
                    "type": "string"
                },
                "defaultSourceFile": {
                    "description": "If defined, the default file to import from a dataset into this input",
                    "type": "string"
                },
                "schema": {
                    "description": "JSON Schema for the file contents: an array of row objects, one property per column",
                    "$ref": "http://json-schema.org/draft-07/schema#"
                }
            }
        }
    }
}