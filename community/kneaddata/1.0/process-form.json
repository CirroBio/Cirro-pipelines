{
  "form": {
    "type": "object",
    "name": "Metagenome Decontamination (KneadData)",
    "required": ["samplesheet"],
    "properties": {
      "samplesheet": {
        "type": "string",
        "schema": "pipeline_samplesheet"
      },
      "reference": {
        "title": "Reference Database",
        "properties": {
          "db": {
            "title": "Decontamination Database",
            "description": "Database of reference genome used for host decontamination",
            "type": "string",
            "default": "kneaddata/human_genome/bowtie2/",
            "enum": [
              "kneaddata/human_genome/bowtie2/",
              "kneaddata/human_transcriptome/bowtie2/",
              "kneaddata/mouse_C57BL/bowtie2/",
              "kneaddata/ribosomal_RNA/bowtie2/"
            ],
            "enumNames": [
              "Human Genome",
              "Human Transcriptome",
              "Mouse Genome",
              "Ribosomal RNA"
            ]
          }    
        }
      },
      "input_options": {
        "title": "Input Options",
        "properties": {
          "sequencer_source": {
            "title": "Sequencer Source",
            "type": "string",
            "description": "Chemistry used for library preparation",
            "default": "NexteraPE",
            "enum": [
              "NexteraPE",
              "TruSeq2",
              "TruSeq3",
              "none"
            ]
          }
        }
      },
      "processing_options": {
        "title": "Processing Options",
        "properties": {
          "decontaminate_pairs": {
            "type": "string",
            "title": "Decontaminate Pairs",
            "description": "Options for filtering of paired end reads",
            "default": "strict",
            "enum": [
              "strict",
              "lenient",
              "unpaired"
            ],
            "enumNames": [
              "remove both R1+R2 if either align",
              "remove only if both R1+R2 align",
              "ignore pairing and remove as single end"
            ]
          }
        }
      }
    }
  },
  "ui": {},
  "structuredInputs": {
    "pipeline_samplesheet": {
      "fileFormat": "CSV",
      "defaultSourceFile": "samplesheet.csv",
      "schema": {
        "title": "Samplesheet",
        "description": "One row per sample, with its pair of R1 and R2 FASTQ files. Each sample can be listed only once, so combine the FASTQ files of a sample sequenced on several lanes before running.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sample": {
              "type": "string",
              "title": "Sample",
              "pattern": "^\\S+$",
              "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "fastq_1": {
              "type": "string",
              "format": "file-path",
              "title": "FASTQ (R1)",
              "pattern": "^(?![\\S\\s]*_I[12]_001\\.fastq\\.gz$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
              "errorMessage": "Must be a gzipped read FASTQ (.fastq.gz or .fq.gz) with no spaces in its name, not an I1/I2 index read"
            },
            "fastq_2": {
              "type": "string",
              "format": "file-path",
              "title": "FASTQ (R2)",
              "pattern": "^(?![\\S\\s]*_I[12]_001\\.fastq\\.gz$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
              "errorMessage": "Must be a gzipped read FASTQ (.fastq.gz or .fq.gz) with no spaces in its name, not an I1/I2 index read"
            }
          },
          "required": [
            "sample",
            "fastq_1",
            "fastq_2"
          ]
        }
      }
    }
  }
}
