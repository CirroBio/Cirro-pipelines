process {
    errorStrategy = 'retry'
    maxRetries = 3
}

// parseSampleSheet is the one process in the workflow that pins its own image
// rather than taking params.container__anvio; pull it from the cirro mirror.
process {
    withName: parseSampleSheet {
        container = 'public.ecr.aws/cirrobio/fhcrc-microbiome/python-pandas:v0.24.2'
    }
}
