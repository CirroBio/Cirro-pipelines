process {
    withName: 'convert_image|convert_image_series' {
        // One image per task, so these are per-image and not per-cohort. A 1.5
        // gigapixel Aperio SVS peaked at 5.8 GB.
        cpus   = 4
        memory = { 16.GB * task.attempt }

        // Retry only what more memory or another host can fix -- JVM and kernel OOM,
        // and Batch/Spot reclamation. QuPath fails an image it cannot read
        // deterministically, so retrying that burns three attempts on one answer.
        // 'finish' lets the images already in flight publish before the run stops.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}
