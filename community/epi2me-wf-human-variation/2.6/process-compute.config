// HealthOmics has no image mapping for bare Docker Hub URIs. Pull every image from
// the mirror where the ontresearch images are staged.
docker {
    registry = 'public.ecr.aws/cirrobio'
}

// modkit and wf-common are multi-arch in the mirror. The plain tags resolve to the
// wrong architecture through the HealthOmics image cache, so pin the amd64 variants.
params {
    wf {
        e2l_mod_tag = "sha489d708a48c66368e5d1e118538e5dca68203a64-amd64"
        common_sha  = "shafdd79f8e4a6faad77513c36f623693977b92b08e-amd64"
    }
}

process {
    errorStrategy = { task.exitStatus in [1, 2, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143, 247] ? 'retry' : 'finish' }
    maxRetries = 3

    withName: '.*annotate_sv_vcf.*'     { cpus = 4; memory = { 16.GB + (4.GB * (task.attempt - 1)) } }
    withName: '.*annotate_snp_vcf.*'    { cpus = 4; memory = { 16.GB + (4.GB * (task.attempt - 1)) } }
    withName: '.*modkit_phase.*'        { memory = { 16.GB + (4.GB * (task.attempt - 1)) } }
    withName: '.*sniffles2.*'           { memory = { 16.GB + (4.GB * (task.attempt - 1)) } }
    withName: '.*refine_with_sv.*'      { memory = { 16.GB + (4.GB * (task.attempt - 1)) } }
    withName: '.*evaluate_candidates.*' { cpus = 2; memory = { 16.GB + (4.GB * (task.attempt - 1)) } }
}
