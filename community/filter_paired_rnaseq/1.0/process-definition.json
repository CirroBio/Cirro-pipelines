{
  "id": "process-hutch-filter-paired-rnaseq-1-0",
  "childProcessIds": [
    "process-hutch-fastqc-1_0",
    "process-nf-core-rnaseq-3",
    "process-nf-core-rnaseq-3_1",
    "process-hutch-immune-clonotypes-1_0",
    "process-nf-core-rnafusion-3_0",
    "process-hutch-filter-paired-rnaseq-1-0",
    "process-hutch-ngscheckmate-1-0",
    "hutch-gig-map-align-pangenome-1-0",
    "hutch-sourmash-tax",
    "process-nf-core-mag-3_0"
  ],
  "dataType": "Paired RNAseq (FASTQ)",
  "name": "Filter RNA Sequences",
  "desc": "Filter out read pairs which align to a user-provided nucleotide sequence",
  "executor": "NEXTFLOW",
  "executionModes": ["STANDARD", "HEALTHOMICS"],
  "pipelineTypeOverride": "Community",
  "category": "Quality Control",
  "documentationUrl": "https://<DOCS_SITE>/pipelines/catalog-quality-control/#filter-sequences",
  "code": {
    "repository": "GITHUBPUBLIC",
    "uri": "FredHutch/star-filter-fastq",
    "version": "main",
    "script": "main.nf"
  },
  "allowMultipleSources": true,
  "usesSampleSheet": false,
  "computeDefaults": [
    {
      "executor": "NEXTFLOW",
      "json": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-compute.config",
      "name": "Default"
    }
  ],
  "paramMapJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-input.json",
  "preProcessScript": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/preprocess.py",
  "formJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-form.json",
  "webOptimizationJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-output.json",
  "fileMappingRules": [
    {
      "description": "Paired FASTQs (R1/R2)",
      "min": 2,
      "fileNamePatterns": [
        {
          "exampleName": "SampleName_R1.fastq.gz",
          "description": "FASTQ",
          "sampleMatchingPattern": "(?P<sampleName>[\\S ]*)(\\.|_)(R|)(?P<read>1|2)\\.(fq|fastq)(\\.gz|)"
        },
        {
          "exampleName": "SampleName_S1_L001_R1_001.fastq.gz",
          "description": "FASTQ (Illumina Format)",
          "sampleMatchingPattern": "(?P<sampleName>\\S*)_S(?P<sampleIndex>\\S*)_L(?P<lane>\\S*)_R(?P<read>1|2)_001\\.fastq\\.gz"
        }
      ]
    }
  ]
}