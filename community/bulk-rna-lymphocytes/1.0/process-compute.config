process {
    errorStrategy = 'retry'
    maxRetries = 2
}

// The workflow pins both images in its own config, so its defaults are the ones to
// beat. Neither can be sent as a run parameter: they are read in modules/predict.nf
// and modules/ingest.nf, and HealthOmics builds the parameter template from the main
// definition file without following an include, so it would reject both names.
params {
    container__quantiseq = 'public.ecr.aws/cirrobio/hdc-workflows/quantiseq:53c1d35'
    container__pandas = 'public.ecr.aws/cirrobio/fhcrc-microbiome/python-pandas:v1.2.1_latest'
}
