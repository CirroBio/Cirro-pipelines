// HealthOmics has no image mapping for bare Docker Hub URIs. Pull every image from
// the mirror where the ontresearch images are staged.
docker {
    registry = 'public.ecr.aws/cirrobio'
}

process {
    errorStrategy = { task.exitStatus in [1, 2, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143, 247] ? 'retry' : 'finish' }
    // The phasing processes size memory from a three-entry table indexed by task.attempt,
    // so a fourth attempt would request a null memory.
    maxRetries = 2

    // severus indexes a two-entry memory table; replace it rather than cap retries further.
    withName: '.*severus.*'      { memory = { 48.GB + (16.GB * (task.attempt - 1)) } }

    // DSS is expected to exhaust memory on large genomes, and the workflow treats that as a
    // skipped analysis rather than a failure. The errorStrategy above would override that.
    withName: '.*dss.*'          { errorStrategy = 'ignore' }

    withName: '.*annotate_vcf.*' { cpus = 4; memory = { 16.GB + (4.GB * (task.attempt - 1)) } }
}
