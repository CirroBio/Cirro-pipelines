// Deliberately NOT redirected to the ECR mirror, unlike the other Docker Hub
// processes. modules.nf reads `container "ncbi/pgap:${params.pgap_version}"` and
// process-form.json offers 32 versions; only the default, 2023-05-17.build6771, is
// mirrored. Adding `docker.registry` would rewrite all 32 to
// public.ecr.aws/cirrobio/ncbi/pgap:<version> and break the 31 that work today.
// PGAP also fails the run-time egress gate independently -- it fetches a multi-GB
// reference tarball over HTTPS -- so it cannot run under networkingMode: RESTRICTED
// whatever is done about registries. Mirror all 32 tags, or constrain the form, first.

process {
    errorStrategy = 'retry'
    maxRetries = 2
}
