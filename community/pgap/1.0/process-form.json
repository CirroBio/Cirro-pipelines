{
  "form": {
    "type": "object",
    "title": "",
    "properties": {
      "genome": {
        "type": "object",
        "title": "Genome Information",
        "description": "Provide details on the organism which was sequenced",
        "required": [
          "fasta",
          "genus_species"
        ],
        "properties": {
          "fasta": {
            "type": "string",
            "title": "Genome",
            "format": "file-path",
            "pattern": "\\.(fa|fasta|fna|fas|fsa)$",
            "errorMessage": "Must be an uncompressed FASTA file (.fa, .fasta, .fna, .fas or .fsa)"
          },
          "genus_species": {
            "type": "string",
            "title": "Organism name",
            "description": "Genus and species (e.g. 'Escherichia coli')"
          },
          "strain": {
            "type": "string",
            "title": "Strain",
            "description": "(optional) Strain of the sequenced organism"
          }
        }
      },
      "contact": {
        "type": "object",
        "title": "Author / Contact Information",
        "description": "PGAP requires contact information to prepare genome assemblies for submission to NCBI RefSeq",
        "required": [
          "last_name",
          "first_name",
          "email",
          "organization",
          "department",
          "phone",
          "street",
          "city",
          "state",
          "postal_code",
          "country"
        ],
        "properties": {
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "first_name": {
            "type": "string",
            "title": "First Name"
          },
          "middle_initial": {
            "type": "string",
            "title": "Middle Initial(s)"
          },
          "email": {
            "type": "string",
            "title": "Email Address"
          },
          "organization": {
            "type": "string",
            "title": "Organization"
          },
          "department": {
            "type": "string",
            "title": "Department"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "street": {
            "type": "string",
            "title": "Street Address"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "postal_code": {
            "type": "string",
            "title": "Postal Code"
          },
          "country": {
            "type": "string",
            "title": "Country"
          }
        }
      },
      "pgap": {
        "type": "object",
        "title": "PGAP Configuration",
        "properties": {
          "version": {
            "type": "string",
            "title": "PGAP Version",
            "default": "2024-07-18.build7555",
            "enum": [
              "2026-06-18.build8602",
              "2026-04-27.build8516",
              "2024-07-18.build7555"
            ]
          }
        }
      }
    }
  },
  "ui": {}
}
