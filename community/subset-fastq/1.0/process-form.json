{
  "form": {
    "type": "object",
    "required": ["samplesheet"],
    "properties": {
      "samplesheet": {
        "type": "string",
        "schema": "pipeline_samplesheet"
      },
      "filtering": {
        "type": "object",
        "title": "Filtering Options",
        "required": ["nreads"],
        "properties": {
          "nreads": {
            "title": "Number of Reads",
            "type": "integer",
            "default": 1000
          }
        }
      }
    }
  },
  "ui": {},
  "structuredInputs": {
    "pipeline_samplesheet": {
      "fileFormat": "CSV",
      "schema": {
        "title": "FASTQ Files",
        "description": "One row per pair of R1 and R2 FASTQ files. Each file is subset on its own and keeps its name, so files from different folders must not share a name.",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "fastq_1": {
              "type": "string",
              "format": "file-path",
              "title": "FASTQ (R1)",
              "pattern": "^(?![\\S\\s]*_I[12]_001\\.f(ast)?q(\\.gz)?$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q(\\.gz)?$",
              "errorMessage": "Must be a read FASTQ (.fq, .fastq, .fq.gz or .fastq.gz) with no spaces in its name, not an I1/I2 index read"
            },
            "fastq_2": {
              "type": "string",
              "format": "file-path",
              "title": "FASTQ (R2)",
              "pattern": "^(?![\\S\\s]*_I[12]_001\\.f(ast)?q(\\.gz)?$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q(\\.gz)?$",
              "errorMessage": "Must be a read FASTQ (.fq, .fastq, .fq.gz or .fastq.gz) with no spaces in its name, not an I1/I2 index read"
            }
          },
          "required": ["fastq_1", "fastq_2"]
        }
      }
    }
  }
}
