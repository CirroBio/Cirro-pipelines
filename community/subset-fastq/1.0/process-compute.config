process {
    errorStrategy = 'retry'
    maxRetries = 2
    cpus = { 1 * task.attempt }
    memory = { 7.GB * task.attempt }
}

// HealthOmics has no image mapping for bare Docker Hub URIs. Pull every image from
// the mirror where these images are staged.
docker {
    registry = 'public.ecr.aws/cirrobio'
}
