process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2

    // One process handles every format. Imaging-platform morphology images are read
    // whole into memory before the pyramidal COG is written, so give it room and
    // double the allocation on an out-of-memory retry.
    withName: 'PREPROCESS_SAMUI' {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
    }

    // Vite/Svelte build of the Samui release.
    withName: 'BUILD_SAMUI' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
}
