process {
    cpus = { 16 * task.attempt }
    memory = { 64.GB * task.attempt }
    errorStrategy = "retry"
    maxRetries = 1

    withLabel:gpu {
        // The workflow runs dorado with --device cuda:all, so these tasks need a
        // GPU. nvidia-t4-a10g-l4 draws from G4, G5 and G6 and is the only spec
        // that prefers the newest generation available, so it trades the least
        // throughput for the widest capacity pool.
        accelerator = [request: 1, type: 'nvidia-t4-a10g-l4']

        // The workflow serialises GPU tasks by default to avoid assigning devices
        // itself; each task is given its own accelerator here, so lift that.
        maxForks = null
    }
}
cleanup = false

// base.config names every image as a bare Docker Hub path -- ontresearch/dorado,
// ontresearch/wf-common, ontresearch/bonito -- and HealthOmics maps only
// public.ecr.aws and quay.io upstreams, so it has no rule for any of them and
// reports "Mapping failed for image ontresearch/dorado". Rewrite them to the
// mirror before the service ever sees the name.
docker {
    registry = 'public.ecr.aws/cirrobio'
}
