{
  "id": "process-epi2me-labs-wf-basecalling-1",
  "childProcessIds": [
    "process-nf-core-sarek-custom-genome-3-5",
    "process-epi2me-wf-human-variation-2"
  ],
  "dataType": "Nanopore Sequencing (BAM/CRAM)",
  "name": "Nanopore Basecalling (Dorado)",
  "desc": "Analyze raw nanopore sequencing data to identify nucleotide sequences",
  "executor": "NEXTFLOW",
  "executionModes": [
    "HEALTHOMICS"
  ],
  "category": "DNA Sequencing",
  "allowMultipleSources": true,
  "documentationUrl": "https://<DOCS_SITE>/pipelines/catalog-nanopore-sequencing/#nanopore-basecalling-dorado",
  "code": {
    "repository": "GITHUBPUBLIC",
    "uri": "epi2me-labs/wf-basecalling",
    "version": "v1.5.9",
    "script": "main.nf"
  },
  "computeDefaults": [
    {
      "executor": "NEXTFLOW",
      "json": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-compute.config",
      "name": "Default"
    }
  ],
  "paramMapJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-input.json",
  "preProcessScript": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/preprocess.py",
  "formJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-form.json",
  "webOptimizationJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-output.json",
  "fileMappingRules": [
    {
      "description": "Basecalled Sequences",
      "min": 1,
      "fileNamePatterns": [
        {
          "exampleName": "SampleName.fast5",
          "description": "fast5",
          "sampleMatchingPattern": "(?P<sampleName>[\\S ]*)\\.fast5"
        },
        {
          "exampleName": "SampleName.bam",
          "description": "bam",
          "sampleMatchingPattern": "(?P<sampleName>[\\S ]*)\\.bam"
        },
        {
          "exampleName": "SampleName.cram",
          "description": "cram",
          "sampleMatchingPattern": "(?P<sampleName>[\\S ]*)\\.cram"
        }
      ]
    }
  ]
}
