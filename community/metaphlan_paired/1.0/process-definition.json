{
  "id": "process-hutch-metaphlan-paired-1-0",
  "childProcessIds": [
    "differential-abundance-metaphlan"
  ],
  "name": "Taxonomic Classification (MetaPhlAn4)",
  "desc": "Identification of microbial sequences within WGS datasets by alignment to the MetaPhlAn database",
  "executor": "NEXTFLOW",
  "category": "Microbial Analysis",
  "documentationUrl": "https://<DOCS_SITE>/pipelines/catalog-microbial-analysis#taxonomic-classification-metaphlan4",
  "code": {
    "repository": "GITHUBPUBLIC",
    "uri": "FredHutch/metaphlan-nf",
    "version": "main",
    "script": "main.nf"
  },
  "allowMultipleSources": true,
  "usesSampleSheet": true,
  "computeDefaults": [
    {
      "executor": "NEXTFLOW",
      "json": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-compute.config",
      "name": "Default"
    }
  ],
  "paramMapJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-input.json",
  "preProcessScript": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/preprocess.py",
  "formJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-form.json",
  "webOptimizationJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-output.json",
  "fileMappingRules": [
    {
      "description": "MetaPhlAn Results",
      "min": 1,
      "fileNamePatterns": [
        {
          "exampleName": "SampleName.metaphlan",
          "description": "MetaPhlAn Results",
          "sampleMatchingPattern": "mpl/(?P<sampleName>[\\S ]*)\\.metaphlan"
        }
      ]
    }
  ]
}