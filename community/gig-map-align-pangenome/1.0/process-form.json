{
    "form": {
        "type": "object",
        "required": [
            "samplesheet"
        ],
        "properties": {
            "samplesheet": {
                "type": "string",
                "schema": "pipeline_samplesheet"
            },
            "inputs": {
                "type": "object",
                "title": "Input Data",
                "required": [
                    "pangenome"
                ],
                "properties": {
                    "pangenome": {
                        "type": "string",
                        "format": "directory-path",
                        "title": "Pangenome",
                        "description": "Precomputed pangenome used as the alignment reference",
                        "process": [
                            "hutch-gig-map-build-pangenome-custom-1-0",
                            "hutch-gig-map-build-pangenome-from-ncbi-1-0"
                        ]
                    }
                }
            },
            "alignment": {
                "type": "object",
                "title": "Alignment Parameters",
                "properties": {
                    "min_score_reads": {
                        "type": "integer",
                        "title": "Minimum Alignment Score",
                        "description": "Threshold applied on a per-read level",
                        "default": 50
                    },
                    "min_identity": {
                        "type": "integer",
                        "title": "Minimum Percent Identity",
                        "description": "Minimum percent identity of the amino acid alignment required to retain the alignment (ranges 0-100)",
                        "default": 90
                    },
                    "max_evalue": {
                        "type": "number",
                        "title": "Maximum E-Value",
                        "description": "Maximum E-value threshold used to filter all alignments",
                        "default": 0.001
                    }
                }
            },
            "filtering": {
                "type": "object",
                "title": "Filtering Parameters",
                "properties": {
                    "min_n_reads": {
                        "type": "integer",
                        "title": "Minimum Number of Reads",
                        "description": "Minimum number of aligned reads required to retain a sample",
                        "default": 1
                    },
                    "min_n_genes": {
                        "type": "integer",
                        "title": "Minimum Number of Genes",
                        "description": "Minimum number of genes required to retain a sample",
                        "default": 1
                    },
                    "famli_sd_mean_cutoff": {
                        "type": "number",
                        "title": "FAMLI SD/Mean Cutoff",
                        "description": "Per-gene filtering threshold based on the ratio of Standard Deviation to Mean alignment depth. Higher values are more relaxed.",
                        "default": 3.0
                    }
                }
            },
            "association": {
                "type": "object",
                "title": "Association Parameters",
                "properties": {
                    "metadata": {
                        "type": "string",
                        "format": "file-path",
                        "pattern": "\\.csv$",
                        "title": "Sample Metadata",
                        "description": "Optional: CSV with a 'sample' column matching the samplesheet, and a column for each variable to compare by"
                    },
                    "category": {
                        "type": "string",
                        "title": "Category",
                        "description": "Optional: Compare sample groups based on this column of the sample metadata"
                    }
                },
                "dependencies": {
                    "category": [
                        "metadata"
                    ]
                }
            }
        }
    },
    "ui": {},
    "structuredInputs": {
        "pipeline_samplesheet": {
            "fileFormat": "CSV",
            "defaultSourceFile": "samplesheet.csv",
            "schema": {
                "title": "Samplesheet",
                "description": "One row per FASTQ file (single-end) or pair of FASTQ files (paired-end). Rows with the same sample name, such as one per sequencing lane, are combined into one sample.",
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "object",
                    "properties": {
                        "sample": {
                            "type": "string",
                            "title": "Sample",
                            "pattern": "^\\S+$",
                            "errorMessage": "Sample name must be provided and cannot contain spaces"
                        },
                        "fastq_1": {
                            "type": "string",
                            "format": "file-path",
                            "title": "FASTQ (R1)",
                            "pattern": "^(?![\\S\\s]*_I[12]_001\\.f(ast)?q(\\.gz)?$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q(\\.gz)?$",
                            "errorMessage": "Must be a read FASTQ (.fq, .fastq, .fq.gz or .fastq.gz) with no spaces in its name, not an I1/I2 index read"
                        },
                        "fastq_2": {
                            "type": "string",
                            "format": "file-path",
                            "title": "FASTQ (R2)",
                            "description": "Leave blank for single-end reads",
                            "pattern": "^(?![\\S\\s]*_I[12]_001\\.f(ast)?q(\\.gz)?$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q(\\.gz)?$",
                            "errorMessage": "Must be a read FASTQ (.fq, .fastq, .fq.gz or .fastq.gz) with no spaces in its name, not an I1/I2 index read"
                        }
                    },
                    "required": [
                        "sample",
                        "fastq_1"
                    ]
                }
            }
        }
    }
}