{
  "form": {
    "type": "object",
    "name": "NGSCheckMate",
    "required": [
      "samplesheet"
    ],
    "properties": {
      "samplesheet": {
        "type": "string",
        "schema": "pipeline_samplesheet"
      }
    }
  },
  "ui": {},
  "structuredInputs": {
    "pipeline_samplesheet": {
      "fileFormat": "CSV",
      "defaultSourceFile": "samplesheet.csv",
      "schema": {
        "title": "Samplesheet",
        "description": "One row per pair of R1 and R2 FASTQ files. Only the first row of each sample is analyzed.",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "sample": {
              "type": "string",
              "title": "Sample",
              "pattern": "^\\S+$",
              "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "fastq_1": {
              "type": "string",
              "format": "file-path",
              "title": "FASTQ (R1)",
              "pattern": "^(?![\\S\\s]*_I[12]_001\\.f(ast)?q(\\.gz)?$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q(\\.gz)?$",
              "errorMessage": "Must be a read FASTQ (.fastq or .fq, optionally gzipped) with no spaces in its name, not an I1/I2 index read"
            },
            "fastq_2": {
              "type": "string",
              "format": "file-path",
              "title": "FASTQ (R2)",
              "pattern": "^(?![\\S\\s]*_I[12]_001\\.f(ast)?q(\\.gz)?$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q(\\.gz)?$",
              "errorMessage": "Must be a read FASTQ (.fastq or .fq, optionally gzipped) with no spaces in its name, not an I1/I2 index read"
            }
          },
          "required": [
            "sample",
            "fastq_1",
            "fastq_2"
          ]
        }
      }
    }
  }
}
