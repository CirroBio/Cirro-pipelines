{
    "form": {
        "type": "object",
        "required": ["input"],
        "properties": {
            "input": {
                "type": "string",
                "schema": "pipeline_samplesheet"
            },
            "metadata": {
                "type": "string",
                "schema": "pipeline_metadata"
            },
            "library": {
                "type": "object",
                "title": "Sequencing Library",
                "properties": {
                    "front_p": {
                        "title": "Forward Primer Sequence",
                        "type": "string",
                        "default": "AGRGTTYGATYMTGGCTCAG"
                    },
                    "adapter_p": {
                        "title": "Reverse Primer Sequence",
                        "type": "string",
                        "default": "AAGTCGTAACAAGGTARCY"
                    },
                    "skip_primer_trim": {
                        "title": "Skip Cutadapt and DADA2 primer removal",
                        "description": "Skip Primer Trimming",
                        "type": "boolean"
                    }
                }
            },
            "filtering": {
                "type": "object",
                "title": "Filtering Parameters",
                "properties": {
                    "filterQ": {
                        "title": "Filter Quality Threshold",
                        "description": "Filter input reads above this Q value",
                        "default": 20,
                        "type": "integer"
                    },
                    "minQ": {
                        "title": "Minimum Quality (minQ)",
                        "description": "Reads with any base lower than this quality score will be removed",
                        "type": "integer",
                        "default": 0
                    },
                    "min_len": {
                        "title": "Minimum Length (bp)",
                        "description": "Sequences shorter than this will be discarded",
                        "type": "integer",
                        "default": 1000
                    },
                    "max_len": {
                        "title": "Maximum Length (bp)",
                        "description": "Sequences longer than this will be discarded",
                        "type": "integer",
                        "default": 1600
                    }
                }
            },
            "denoising": {
                "type": "object",
                "title": "Denoising Parameters",
                "properties": {
                    "max_ee": {
                        "title": "Maximum Expected Errors (max_EE)",
                        "description": "Reads with number of expected errors higher than this value will be discarded",
                        "type": "integer",
                        "default": 2
                    },
                    "pooling_method": {
                        "title": "Pooling Method",
                        "description": "QIIME 2 pooling method for DADA2 denoising",
                        "type": "string",
                        "default": "independent",
                        "enum": ["independent", "pseudo"]
                    }
                }
            },
            "classification": {
                "type": "object",
                "title": "Classification Parameters",
                "properties": {
                    "maxreject": {
                        "title": "Max Reject",
                        "description": "QIIME 2 max-reject parameter for VSEARCH taxonomy classification method",
                        "type": "integer",
                        "default": 100
                    },
                    "maxaccept": {
                        "title": "Max Accept",
                        "description": "QIIME 2 max-accept parameter for VSEARCH taxonomy classification method",
                        "type": "integer",
                        "default": 100
                    },
                    "vsearch_identity": {
                        "title": "Minimum Identity",
                        "description": "Minimum identity to be considered as hit",
                        "type": "number",
                        "default": 0.97
                    },
                    "skip_nb": {
                        "title": "Only uses VSEARCH",
                        "description": "Skip Naive-Bayes Classification",
                        "type": "boolean"
                    }
                }
            },
            "outputs": {
                "title": "Output Parameters",
                "type": "object",
                "properties": {
                    "min_asv_totalfreq": {
                        "title": "Minimum Counts per ASV",
                        "description": "Total counts of any ASV across all samples must be above this threshold to be retained",
                        "type": "integer",
                        "default": 5
                    },
                    "min_asv_sample": {
                        "title": "Minimum Samples per ASV",
                        "description": "Minimum number of samples that an ASV must be found in to be retained",
                        "type": "integer",
                        "default": 1
                    }
                }
            }
        }
    },
    "ui": {},
    "structuredInputs": {
        "pipeline_samplesheet": {
            "fileFormat": "TSV",
            "schema": {
                "title": "Samples",
                "description": "One row per sample, with its HiFi reads in a single FASTQ file.",
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "object",
                    "properties": {
                        "sample-id": {
                            "type": "string",
                            "title": "Sample",
                            "pattern": "^[A-Za-z0-9._-]+$",
                            "errorMessage": "Sample names can only contain letters, numbers, periods, hyphens and underscores"
                        },
                        "absolute-filepath": {
                            "type": "string",
                            "format": "file-path",
                            "title": "HiFi FASTQ",
                            "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q(\\.gz)?$",
                            "errorMessage": "Must be a FASTQ file (.fastq or .fq, optionally gzipped) with no spaces in its name"
                        }
                    },
                    "required": ["sample-id", "absolute-filepath"]
                }
            }
        },
        "pipeline_metadata": {
            "fileFormat": "TSV",
            "schema": {
                "title": "Sample Metadata",
                "description": "Optional. One row per sample, named as in the samples table. Left empty, the samples are given placeholder conditions.",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "sample_name": {
                            "type": "string",
                            "title": "Sample",
                            "pattern": "^[A-Za-z0-9._-]+$",
                            "errorMessage": "Sample names can only contain letters, numbers, periods, hyphens and underscores"
                        },
                        "condition": {
                            "type": "string",
                            "title": "Condition",
                            "description": "Group used to color samples in the report"
                        },
                        "pool": {
                            "type": "string",
                            "title": "Pool",
                            "description": "Optional. Samples in different pools are denoised separately by DADA2"
                        }
                    },
                    "required": ["sample_name", "condition"]
                }
            }
        }
    }
}