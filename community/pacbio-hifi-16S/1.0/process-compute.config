process {
    errorStrategy = 'retry'
    maxRetries = 2

    cpus = { 8 * task.attempt }
    memory = { 16.GB * task.attempt }

}

params {
    enable_conda = false
    enable_container = true
}

conda.enabled = false

// HealthOmics has no image mapping for bare Docker Hub URIs. Pull every image from
// the mirror where these images are staged.
docker {
    registry = 'public.ecr.aws/cirrobio'
}
