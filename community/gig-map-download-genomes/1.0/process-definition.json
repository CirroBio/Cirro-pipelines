{
    "id": "hutch-gig-map-download-genomes-1-0",
    "childProcessIds": [
      "hutch-gig-map-build-pangenome-custom-1-0"
    ],
    "dataType": "Genome Sequences (FASTA)",
    "name": "Download Genomes",
    "desc": "Fetch the nucleotide sequences for a set of NCBI genomes (FASTA)",
    "executor": "NEXTFLOW",
    "category": "Microbial Analysis",
    "documentationUrl": "https://<DOCS_SITE>/pipelines/catalog-microbial-analysis/#download-genomes",
    "code": {
        "repository": "GITHUBPUBLIC",
        "script": "download_genomes.nf",
        "uri": "FredHutch/gig-map",
        "version": "main"
    },
    "allowMultipleSources": true,
    "usesSampleSheet": false,
    "computeDefaults": [
        {
            "executor": "NEXTFLOW",
            "json": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-compute.config",
            "name": "Default"
        }
    ],
    "preProcessScript": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/preprocess.py",
    "paramMapJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-input.json",
    "formJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-form.json",
    "webOptimizationJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-output.json",
    "fileMappingRules": [
      {
        "description": "Genome Sequences (FASTA)",
        "min": 1,
        "fileNamePatterns": [
          {
            "exampleName": "genomeName_genomic.fna.gz",
            "description": "FASTA",
            "sampleMatchingPattern": "(?P<sampleName>[\\S ]*)_genomic\\.fna\\.gz"
      
          }
        ]
      }
    ]
  
}