{
  "form": {
    "type": "object",
    "required": ["samplesheet"],
    "properties": {
      "samplesheet": {
        "type": "string",
        "schema": "pipeline_samplesheet"
      },
      "genome": {
        "title": "Reference Genome",
        "type": "string",
        "enum": [
          "Homo sapiens (GRCh38)"
        ],
        "default": "Homo sapiens (GRCh38)"
      },
      "dragen_mode": {
        "title": "DRAGEN-GATK Mode",
        "type": "string",
        "enum": [
          "Disabled",
          "Enabled (Functional Equivalence)",
          "Enabled (Maximum Quality)"
        ],
        "default": "Disabled",
        "help_text": "Adjust parameters to run the WGS workflow in the DRAGEN-GATK mode"
      }
    }
  },
  "ui": {},
  "structuredInputs": {
    "pipeline_samplesheet": {
      "fileFormat": "CSV",
      "schema": {
        "title": "Unmapped BAMs",
        "description": "One row per unmapped BAM (one read group each). Rows with the same sample are analyzed together as that sample",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "sample_name": {
              "type": "string",
              "title": "Sample",
              "pattern": "^\\S+$",
              "errorMessage": "Must not contain spaces"
            },
            "flowcell_unmapped_bams": {
              "type": "string",
              "format": "file-path",
              "title": "Unmapped BAM",
              "pattern": "\\.bam$"
            }
          },
          "required": ["sample_name", "flowcell_unmapped_bams"]
        }
      }
    }
  }
}
