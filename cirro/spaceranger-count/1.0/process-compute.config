process {
    errorStrategy = 'retry'
    maxRetries = 3
    withLabel: spaceranger {
        container = "quay.io/cumulus/spaceranger:${params.spaceranger_version}"
        beforeScript = ""
        cpus = { 4 * task.attempt }
        memory = { 30.GB * task.attempt }
    }
}

params {
    // Read by the container line above. No workflow in nf-cellranger-tools declares
    // spaceranger_version -- unlike cellranger_version -- so it cannot travel as a
    // run parameter; HealthOmics rejects a name the workflow never declares.
    spaceranger_version = '3.1.2'
}
