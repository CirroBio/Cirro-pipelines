// The workflow's own nextflow.config gives ANALYSE 4 CPUs / 32 GB; a large section
// (Visium HD, a whole Xenium slide) needs more, so double on an out-of-memory retry.
// Every task installs its Python dependencies at startup (uv + apt), so tasks need
// outbound network access to PyPI, the apt mirrors, and github.com.
process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'ANALYSE' {
        cpus   = { 4 * task.attempt }
        memory = { 32.GB * task.attempt }
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = 4.GB
    }
    withName: 'PUBLISH_VIEWER' {
        cpus   = 1
        memory = 2.GB
    }
}
