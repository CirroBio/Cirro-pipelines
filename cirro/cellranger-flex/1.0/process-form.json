{
  "form": {
    "type": "object",
    "required": [
      "fastq_dir",
      "samplesheet"
    ],
    "properties": {
      "fastq_dir": {
        "title": "FASTQ Folders",
        "description": "Datasets or folders holding the FASTQ files (.fastq.gz). Cell Ranger finds the files of each library in the samplesheet by its sample name",
        "type": "string",
        "format": "directory-path",
        "multiple": true
      },
      "samplesheet": {
        "type": "string",
        "schema": "pipeline_samplesheet"
      },
      "flex_version": {
        "title": "Flex Chemistry",
        "description": "Flex v2 (Apex) uses a different probe set and plate-style probe barcodes, and requires CellRanger 10",
        "type": "string",
        "default": "v1",
        "enum": [
          "v1",
          "v2"
        ],
        "enumNames": [
          "Flex v1 (probe barcodes BC001-BC016)",
          "Flex v2 / Apex (probe barcodes A-A01 to D-H12)"
        ]
      },
      "probe_set": {
        "title": "(optional) Custom Probe Set",
        "description": "By default, the 10X Chromium probe set built for the selected reference genome is used",
        "type": "string",
        "file": "**/cellranger_probe_set/**/cellranger_probe_set.csv",
        "pathType": "references",
        "default": ""
      },
      "params": {
        "type": "object",
        "title": "Analysis Parameters",
        "properties": {
          "cellranger_version": {
            "title": "CellRanger Version",
            "type": "string",
            "default": "10.0.0",
            "enum": [
              "10.0.0",
              "9.0.1",
              "9.0.0",
              "8.0.0",
              "7.2.0",
              "7.1.0",
              "7.0.1",
              "7.0.0"
            ]
          },
          "emptydrops_minimum_umis": {
            "title": "(optional) Minimum UMIs for Cell Calling",
            "description": "Barcodes with fewer UMIs are not considered in the second (EmptyDrops) step of cell calling. Leave blank for the CellRanger default of 500; 10X suggests starting at 100 to recover more cells. Requires CellRanger 7.1 or later",
            "type": "integer",
            "minimum": 0
          },
          "global_minimum_umis": {
            "title": "(optional) Minimum UMIs per Cell",
            "description": "Barcodes with fewer UMIs are not called as cells. Leave blank to keep every called cell (the CellRanger default). Requires CellRanger 8.0 or later",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "dependencies": {
      "flex_version": {
        "oneOf": [
          {
            "properties": {
              "flex_version": {
                "enum": ["v1"]
              },
              "reference": {
                "title": "Reference Genome",
                "description": "Reference genome used for alignment of RNAseq data",
                "type": "string",
                "default": "Homo sapiens (GRCh38-2024)",
                "enum": [
                  "Homo sapiens (GRCh38-2024)",
                  "Homo sapiens (GRCh38-2020)",
                  "Mus musculus (GRCm39-2024)",
                  "Mus musculus (mm10-2020)"
                ]
              },
              "samples": {
                "type": "object",
                "title": "Samples",
                "description": "Assign a sample to each probe barcode",
                "properties": {
                  "barcode_source": {
                    "title": "Barcode Assignment",
                    "type": "string",
                    "default": "manual",
                    "enum": [
                      "manual",
                      "table",
                      "reference"
                    ],
                    "enumNames": [
                      "Enter barcodes manually",
                      "Fill out a barcode table",
                      "Use saved barcode table"
                    ]
                  }
                },
                "dependencies": {
                  "barcode_source": {
                    "oneOf": [
                      {
                        "properties": {
                          "barcode_source": {
                            "enum": ["manual"]
                          },
                          "bc001": {"type": "string", "title": "BC001"},
                          "bc002": {"type": "string", "title": "BC002"},
                          "bc003": {"type": "string", "title": "BC003"},
                          "bc004": {"type": "string", "title": "BC004"},
                          "bc005": {"type": "string", "title": "BC005"},
                          "bc006": {"type": "string", "title": "BC006"},
                          "bc007": {"type": "string", "title": "BC007"},
                          "bc008": {"type": "string", "title": "BC008"},
                          "bc009": {"type": "string", "title": "BC009"},
                          "bc010": {"type": "string", "title": "BC010"},
                          "bc011": {"type": "string", "title": "BC011"},
                          "bc012": {"type": "string", "title": "BC012"},
                          "bc013": {"type": "string", "title": "BC013"},
                          "bc014": {"type": "string", "title": "BC014"},
                          "bc015": {"type": "string", "title": "BC015"},
                          "bc016": {"type": "string", "title": "BC016"}
                        }
                      },
                      {
                        "properties": {
                          "barcode_source": {
                            "enum": ["table"]
                          },
                          "probe_barcodes": {
                            "type": "string",
                            "schema": "pipeline_probe_barcodes"
                          }
                        }
                      },
                      {
                        "properties": {
                          "barcode_source": {
                            "enum": ["reference"]
                          },
                          "barcode_reference": {
                            "type": "string",
                            "title": "Saved Barcode Table",
                            "description": "CSV with columns sample_id and probe_barcode_ids (or sample_barcode_ids). To add a table, go to Pipelines > Manage References > Add Reference and upload it as the Spreadsheet (CSV) reference type",
                            "pathType": "references",
                            "file": "**/spreadsheet_csv/**/spreadsheet.csv"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "flex_version": {
                "enum": ["v2"]
              },
              "reference": {
                "title": "Reference Genome",
                "description": "Flex v2 probe sets are built for the 2024-A references only",
                "type": "string",
                "default": "Homo sapiens (GRCh38-2024)",
                "enum": [
                  "Homo sapiens (GRCh38-2024)",
                  "Mus musculus (GRCm39-2024)"
                ]
              },
              "samples": {
                "type": "object",
                "title": "Samples",
                "description": "Assign a sample to each probe barcode",
                "properties": {
                  "barcode_source": {
                    "title": "Barcode Assignment",
                    "type": "string",
                    "default": "table",
                    "enum": [
                      "table",
                      "reference"
                    ],
                    "enumNames": [
                      "Fill out a barcode table",
                      "Use saved barcode table"
                    ]
                  }
                },
                "dependencies": {
                  "barcode_source": {
                    "oneOf": [
                      {
                        "properties": {
                          "barcode_source": {
                            "enum": ["table"]
                          },
                          "probe_barcodes": {
                            "type": "string",
                            "schema": "pipeline_probe_barcodes"
                          }
                        }
                      },
                      {
                        "properties": {
                          "barcode_source": {
                            "enum": ["reference"]
                          },
                          "barcode_reference": {
                            "type": "string",
                            "title": "Saved Barcode Table",
                            "description": "CSV with columns sample_id and probe_barcode_ids (or sample_barcode_ids). To add a table, go to Pipelines > Manage References > Add Reference and upload it as the Spreadsheet (CSV) reference type",
                            "pathType": "references",
                            "file": "**/spreadsheet_csv/**/spreadsheet.csv"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "ui": {
    "ui:order": [
      "fastq_dir",
      "samplesheet",
      "flex_version",
      "reference",
      "probe_set",
      "samples",
      "params"
    ],
    "samples": {
      "barcode_source": {
        "ui:widget": "radio"
      }
    }
  },
  "structuredInputs": {
    "pipeline_samplesheet": {
      "fileFormat": "CSV",
      "schema": {
        "title": "Samplesheet",
        "description": "One row per library: the sample name its FASTQ files start with (the part before _S1_L001_R1_001.fastq.gz). The libraries are analyzed together in one Cell Ranger run, which splits the cells into samples by probe barcode.",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "sample": {
              "type": "string",
              "title": "Sample",
              "pattern": "^[A-Za-z0-9_-]+$",
              "errorMessage": "Sample names can only contain letters, numbers, hyphens and underscores"
            }
          },
          "required": [
            "sample"
          ]
        }
      }
    },
    "pipeline_probe_barcodes": {
      "fileFormat": "CSV",
      "schema": {
        "title": "Probe Barcodes",
        "description": "One row per sample, with the probe barcode used for it: BC001 to BC016 for Flex v1, A-A01 to D-H12 for Flex v2. List the barcodes of a sample that used several on separate rows, or in one cell separated by a pipe (e.g. BC001|BC002).",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "sample_id": {
              "type": "string",
              "title": "Sample",
              "pattern": "^[A-Za-z0-9_-]+$",
              "errorMessage": "Sample names can only contain letters, numbers, hyphens and underscores"
            },
            "probe_barcode_ids": {
              "type": "string",
              "title": "Probe Barcode IDs",
              "pattern": "^(BC0(0[1-9]|1[0-6])|[A-D]-[A-H](0[1-9]|1[0-2]))(\\|(BC0(0[1-9]|1[0-6])|[A-D]-[A-H](0[1-9]|1[0-2])))*$",
              "errorMessage": "Must be BC001 to BC016 (Flex v1) or A-A01 to D-H12 (Flex v2); separate several with a pipe (e.g. BC001|BC002)"
            }
          },
          "required": [
            "sample_id",
            "probe_barcode_ids"
          ]
        }
      }
    }
  }
}
