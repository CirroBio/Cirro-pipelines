process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'terminate' }
    maxRetries = 3
    cpus = params.cpus
    memory = params.memory
    time = params.time
}
params {
    container = "public.ecr.aws/cirrobio/qupath:v0.6.0"

    // Read by the process scope above. The workflow itself never mentions them, so
    // without a declaration here they are parameters nothing in the bundle defines.
    // cpus was never supplied at all, leaving process.cpus null on every run.
    cpus = 4
    memory = "32.GB"
    time = "4h"
}