// These were form fields once and are fixed now, so they are written here rather
// than routed through params: a params block is evaluated in file order, and the
// process scope below would read them before they existed.
process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'terminate' }
    maxRetries = 3
    cpus = 4
    memory = "32.GB"
    time = "4h"
}

params {
    // A default only; the run supplies its own container built from the form's
    // QuPath version, and a run parameter beats a config value.
    container = "public.ecr.aws/cirrobio/qupath:v0.6.0"
}
