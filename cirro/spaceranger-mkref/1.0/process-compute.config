process {
    errorStrategy = 'retry'
    maxRetries = 3
    withLabel: spaceranger {
        // Pinned rather than read from params: a params block is evaluated in
        // file order, so this line would run before one below it existed. No
        // workflow in nf-cellranger-tools declares spaceranger_version either.
        container = "quay.io/cumulus/spaceranger:3.1.2"
        beforeScript = ""
        cpus = { 4 * task.attempt }
        memory = { 24.GB * task.attempt }
    }
    withLabel: python {
        container = "quay.io/fhcrc-microbiome/python-pandas:4a6179f"
        beforeScript = ""
        cpus = { 4 * task.attempt }
        memory = { 30.GB * task.attempt }
    }
}
