{
  "form": {
    "type": "object",
    "description": "Custom probe sequences will be combined with the human or mouse reference genome",
    "required": [
      "custom"
    ],
    "properties": {
      "custom": {
        "title": "Custom Sequences",
        "description": "Folder(s) of FASTA files, each sequence added to the reference as its own gene and probe. Every file in the folder is read",
        "type": "string",
        "format": "directory-path",
        "multiple": true,
        "process": [
          "genome_fasta"
        ]
      },
      "genome_dir": {
        "title": "Reference Genome",
        "description": "Reference genome used in conjunction with custom probes",
        "type": "string",
        "default": "cellranger/refdata-gex-GRCh38-2024-A",
        "enum": [
          "cellranger/refdata-gex-GRCh38-2024-A",
          "cellranger/refdata-gex-GRCh38-2020-A",
          "cellranger/refdata-gex-GRCm39-2024-A",
          "cellranger/refdata-gex-mm10-2020-A"
        ],
        "enumNames": [
          "Homo sapiens (GRCh38-2024)",
          "Homo sapiens (GRCh38-2020)",
          "Mus musculus (GRCm39-2024)",
          "Mus musculus (mm10-2020)"
        ]
      },
      "probes": {
        "title": "Probes",
        "description": "Reference genome probe set to be merged with custom probes",
        "type": "string",
        "default": "cellranger/flex/Chromium_Human_Transcriptome_Probe_Set_v1.0.1_GRCh38-2020-A.csv",
        "enum": [
          "cellranger/flex/Chromium_Human_Transcriptome_Probe_Set_v1.0.1_GRCh38-2020-A.csv",
          "cellranger/flex/Chromium_Mouse_Transcriptome_Probe_Set_v1.0.1_mm10-2020-A.csv"
        ],
        "enumNames": [
          "Human Transcriptome Probe Set v1.0.1 (GRCh38-2020-A)",
          "Mouse Transcriptome Probe Set v1.0.1 (mm10-2020-A)"
        ]
      }
    }
  },
  "ui": {}
}
