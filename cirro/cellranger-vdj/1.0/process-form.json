{
  "form": {
    "type": "object",
    "required": [
      "fastq_dir"
    ],
    "properties": {
      "fastq_dir": {
        "title": "FASTQ Folder",
        "description": "Folder of 10X FASTQ files named <sample>_S<n>_L<lane>_R<1|2>_001.fastq.gz. Every sample with files at the top of the folder is analyzed",
        "type": "string",
        "format": "directory-path",
        "process": [
          "single-cell-10X"
        ]
      },
      "vdj_dir": {
        "title": "Genome",
        "description": "Reference genome used for alignment of V(D)J data",
        "type": "string",
        "default": "cellranger/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0",
        "enum": [
          "cellranger/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0",
          "cellranger/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.0.0",
          "cellranger/refdata-cellranger-vdj-GRCm38-alts-ensembl-7.0.0"
        ],
        "enumNames": [
          "Homo sapiens (7.1.0)",
          "Homo sapiens (7.0.0)",
          "Mus musculus (7.0.0)"
        ]
      },
      "cellranger_version": {
        "title": "CellRanger Version",
        "type": "string",
        "default": "10.0.0",
        "enum": [
          "10.0.0",
          "9.0.1",
          "9.0.0",
          "8.0.0",
          "7.2.0",
          "7.1.0",
          "7.0.1",
          "7.0.0",
          "6.1.2",
          "6.1.1",
          "6.0.2",
          "6.0.1",
          "6.0.0",
          "5.0.1",
          "5.0.0",
          "4.0.0",
          "3.1.0",
          "3.0.2",
          "2.2.0"
        ]
      }
    }
  },
  "ui": {}
}
