docker.registry     = 'quay.io'
apptainer.registry  = 'quay.io'

process {
    // nf-core's bwa/index asks for 6 B per base, about 28 MB for a bacterial genome,
    // which is killed for lack of memory; keep that scaling but never go below 2 GB
    withName: 'BWAMEM1_INDEX' {
        memory = { [2.GB, 6.B * fasta.size()].max() }
    }
}
