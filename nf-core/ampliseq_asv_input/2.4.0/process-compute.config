process {
    errorStrategy = 'retry'
    maxRetries = 3
}

// These modules hard-code a docker.io/ host, which HealthOmics cannot pull, and
// docker.registry cannot rewrite. Override the container directly; a withName block
// replaces the whole directive, including the nf-core singularity/docker ternary.
// Every other image is a bare name that the workflow's own docker.registry sends to quay.io.
process {
    withName: 'FORMAT_TAXONOMY|FORMAT_TAXONOMY_QIIME|FORMAT_TAXONOMY_SIDLE|FORMAT_TAXONOMY_SINTAX' {
        container = 'public.ecr.aws/cirrobio/biocontainers/biocontainers:v1.2.0_cv1'
    }
}
