profiles {
    standard {
        process {
            maxRetries = 2
        }
    }
}

params {
    max_memory  = 256.GB
    max_cpus    = 24
    max_time    = 240.h
}

process {
    // Native Nextflow resource capping (24.x+), replacing the community
    // check_max() helper pattern -- a bare `def function(){}` declaration in
    // a config file parses under older Nextflow but is rejected outright by
    // Nextflow 26.x's stricter config grammar ("Unexpected input: '('").
    // resourceLimits caps every declared cpus/memory/time below without
    // needing a helper function at all.
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    withName: '.*:MERGED_LIBRARY_BAM_TO_BIGWIG:BEDTOOLS_GENOMECOV' {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
}
