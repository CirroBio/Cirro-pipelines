// The four FORMAT_TAXONOMY* processes are the only ones that name a docker.io
// image. HealthOmics resolves images through a registry map that covers
// public.ecr.aws and quay.io but not docker.io, so point them at the mirror.
// Kept outside the profile so the override applies whichever profile resolves.
process {
    withName: 'FORMAT_TAXONOMY|FORMAT_TAXONOMY_QIIME|FORMAT_TAXONOMY_SINTAX|FORMAT_TAXONOMY_SIDLE' {
        container = 'public.ecr.aws/cirrobio/biocontainers/biocontainers:v1.2.0_cv1'
    }
}

profiles {
    standard {
        process {
            errorStrategy = 'retry'
            maxRetries = 3
        }
    }
}
