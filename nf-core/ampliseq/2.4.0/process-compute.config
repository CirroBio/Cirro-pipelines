profiles {
    standard {
        process {
            errorStrategy = 'retry'
            maxRetries = 3
        }
    }
}

// These modules hard-code a docker.io/ host, so docker.registry cannot rewrite them.
// Override the container directly; a withName block replaces the whole directive,
// including the nf-core singularity/docker ternary.
process {
    withName: 'FORMAT_TAXONOMY|FORMAT_TAXONOMY_QIIME|FORMAT_TAXONOMY_SIDLE|FORMAT_TAXONOMY_SINTAX' {
        container = 'public.ecr.aws/cirrobio/biocontainers/biocontainers:v1.2.0_cv1'
    }
}
