params{
    wes = false
    trim_fastq = false
    clip_r1 = 0
    clip_r2 = 0
    three_prime_clip_r1 = 0
    three_prime_clip_r2 = 0
    trim_nextseq = false
    save_trimmed = false
    genome = null
    intervals = null
    validationSchemaIgnoreParams = "compute_multiplier"
    save_output_as_bam = true
    save_mapped = true

    max_memory                 = 488.GB
    max_cpus                   = 64
    max_time                   = 240.h
}

process{

    errorStrategy = 'retry'
    maxRetries = 5

    // Native Nextflow resource capping (24.x+), replacing the community
    // check_max() helper pattern -- a bare `def function(){}` declaration at
    // the top of a config file parses under older Nextflow but is rejected
    // outright by Nextflow 26.x's stricter config grammar ("Unexpected
    // input: '('"). resourceLimits caps every declared cpus/memory/time
    // below without needing a helper function at all.
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    withLabel:process_low {
        cpus         = { 2 * task.attempt }
        memory       = { 15.GB * task.attempt }
        time         = { 24.h }
    }
    withLabel:process_medium {
        cpus         = { 4 * params.compute_multiplier * task.attempt }
        memory       = { 30.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h }
    }
    withLabel:process_high {
        cpus         = { 8 * params.compute_multiplier * task.attempt }
        memory       = { 60.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
    }
    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus         = { 16 * params.compute_multiplier * task.attempt }
        memory       = { 120.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
    }
    // Powers `--aligner parabricks`. PARABRICKS_FQ2BAM carries sarek's own
    // `process_gpu` label, but sarek's own conf/base.config (added in
    // nf-core/sarek #2029, merged 3.6.1+) also sets `accelerator` on this
    // process BY NAME: `withName: 'PARABRICKS_FQ2BAM' { accelerator = {
    // task.executor in ['awsbatch', ...] ? 4 : null } }`. A `withName`
    // selector always wins over a `withLabel` selector for the same
    // directive regardless of which config file loads later, so a
    // `withLabel:process_gpu { accelerator = N }` override here would
    // silently do nothing on awsbatch -- sarek's own 4-GPU default applies
    // no matter what. We match sarek's selector type and pin the count
    // explicitly rather than relying on sarek's default, since a different
    // `workflow_version` may not set it at all (it's only present 3.6.1+)
    // or may change it later.
    //
    // cpus/memory deliberately don't target a specific instance's exact
    // specs -- Batch (not Nextflow) picks the actual instance from whatever
    // the compute environment allows, and 4-GPU sizes within a family vary
    // widely in RAM (e.g. g6.12xlarge 192GB vs g6.24xlarge 384GB vs
    // g6e.12xlarge 384GB), so there's no single box to size against, and
    // Batch may legitimately place other work on the same host's leftover
    // capacity regardless -- that's fine, since the memory below becomes a
    // hard per-container cgroup limit that isolates this job from whatever
    // else shares the host. So this is a floor comfortably above where a
    // real run OOM'd at the old 120GB (60GB * compute_multiplier(2)), not a
    // ceiling matched to any particular instance. Scales with task.attempt
    // like every other resource-heavy process in this file, since the
    // compute environment does have larger sizes to escalate into on retry
    // (e.g. g6e.24xlarge at 768GB).
    //
    // ext.args below must extend, not replace, sarek's own PARABRICKS_FQ2BAM
    // ext.args (conf/modules/aligner.config) -- both are `withName`
    // selectors setting the same directive, and Cirro's loads later, so a
    // plain override here would silently drop the --read-group-* args
    // Mutect2 needs downstream (see the GATK4_MARKDUPLICATES override below
    // for the same gotcha). The extra flags mirror nf-core/sarek's own
    // documented OOM mitigation for fq2bam (docs/usage.md, added in #2029):
    // halving --bwa-nstreams and adding --gpuwrite/--gpusort trade some
    // throughput for materially lower peak memory.
    withName: 'PARABRICKS_FQ2BAM' {
        accelerator = 4
        cpus        = { 16 * params.compute_multiplier * task.attempt }
        memory      = { 150.GB * params.compute_multiplier * task.attempt }
        time        = { 24.h * params.compute_multiplier }
        ext.args    = { [
            "--read-group-id-prefix ${meta.sample_lane_id}",
            "--read-group-sm ${meta.patient}_${meta.sample}",
            "--read-group-lb ${meta.sample}",
            "--read-group-pl ${params.seq_platform}",
            meta.status == 1 ? "--bwa-options='-K 100000000 -Y -B 3'" : "--bwa-options='-K 100000000 -Y'",
            "--bwa-nstreams 2",
            "--gpuwrite",
            "--gpusort",
        ].join(' ').trim() }
    }
    withName:'GATK4_APPLYBQSR_SPARK|GATK4_BASERECALIBRATOR|GATK4_GATHERBQSRREPORTS'{
        cpus         = { 2 * params.compute_multiplier * task.attempt }
        memory       = { 16.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
    }
    withName: 'GATK4_APPLYBQSR'{
        cpus         = { 2 * params.compute_multiplier * task.attempt }
        memory       = { 16.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h * params.compute_multiplier }
        queue        = env('PW_ONDEMAND_JOB_QUEUE')
    }
    withName: 'GATK4_MARKDUPLICATES|BAM_MARKDUPLICATES'{
        cpus         = { 16 * params.compute_multiplier * task.attempt }
        memory       = { 120.GB * params.compute_multiplier * task.attempt }
        time         = { 48.h * params.compute_multiplier }
        queue        = env('PW_ONDEMAND_JOB_QUEUE')
        // Mirrors nf-core/sarek's own GATK4_MARKDUPLICATES ext.args (conf/modules/markduplicates.config),
        // just wired to Cirro's own param name for pixel distance (params.optical_duplicate_pixel_distance,
        // set via process-input.json) instead of sarek's params.markduplicates_pixel_distance, which Cirro
        // never sets. A prior plain-string override here replaced sarek's closure outright instead of
        // extending it, silently dropping --CREATE_INDEX true -- so GATK4_MARKDUPLICATES.out.bai was never
        // emitted whenever save_output_as_bam was set, and the downstream .join(failOnMismatch: true) of
        // .out.bam against .out.bai in bam_markduplicates/main.nf failed with a "Join mismatch" error.
        ext.args     = { [
            "--REMOVE_DUPLICATES false",
            "--VALIDATION_STRINGENCY LENIENT",
            params.save_output_as_bam ? "--CREATE_INDEX true" : '',
            params.optical_duplicate_pixel_distance ? "--OPTICAL_DUPLICATE_PIXEL_DISTANCE ${params.optical_duplicate_pixel_distance}" : '',
            params.umi_tag ? "--BARCODE_TAG ${params.umi_tag}" :
                (params.umi_in_read_header || params.umi_length ? "--BARCODE_TAG RX" : "")
        ].join(" ").trim() }
    }
    withName: 'FREEBAYES|SAMTOOLS_STATS|SAMTOOLS_INDEX|UNZIP' {
        cpus         = { 4 * params.compute_multiplier * task.attempt }
        memory       = { 30.GB * params.compute_multiplier * task.attempt }
        time         = { 24.h }
    }
}

docker.registry       = 'quay.io'
apptainer.registry  = 'quay.io'
