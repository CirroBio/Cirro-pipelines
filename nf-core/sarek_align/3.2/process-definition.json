{
  "id": "process-nf-core-sarek-align-3-2",
  "childProcessIds": [
    "process-nf-core-sarek-call-variants-3-2"
  ],
  "dataType": "Aligned Reads (BAM/CRAM)",
  "name": "Align Reads (nf-core/sarek)",
  "desc": "Align genomic reads to a reference genome based on GATK4 best practices",
  "executor": "NEXTFLOW",
  "pipelineTypeOverride": "nf-core",
  "category": "DNA Sequencing",
  "documentationUrl": "https://<DOCS_SITE>/pipelines/catalog-dna-sequencing/#dna-variant-calling-nf-coresarek",
  "code": {
    "repository": "GITHUBPUBLIC",
    "script": "main.nf",
    "uri": "nf-core/sarek",
    "version": "User Defined",
    "executorVersion": "25.10.4"
  },
  "allowMultipleSources": true,
  "usesSampleSheet": true,
  "computeDefaults": [
    {
      "executor": "NEXTFLOW",
      "json": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-compute.config",
      "name": "Default"
    }
  ],
  "paramMapJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-input.json",
  "preProcessScript": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/preprocess.py",
  "formJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-form.json",
  "webOptimizationJson": "s3://<RESOURCES_BUCKET>/<PROCESS_DIRECTORY>/process-output.json",
  "fileMappingRules": [
    {
      "description": "Aligned Reads",
      "min": 2,
      "fileNamePatterns": [
        {
          "exampleName": "preprocessing/recalibrated/SampleName/SampleName.recal.bam",
          "description": "Recalibrated alignments (BAM/CRAM)",
          "sampleMatchingPattern": "preprocessing/(?P<bamType>recalibrated)/(?P<sampleName>[^/]+)/[^/]+\\.(?:bam|cram)$"
        },
        {
          "exampleName": "preprocessing/recalibrated/SampleName/SampleName.recal.bam.bai",
          "description": "Recalibrated alignments (BAM/CRAM Index)",
          "sampleMatchingPattern": "preprocessing/(?P<bamType>recalibrated)/(?P<sampleName>[^/]+)/[^/]+\\.(?:bam\\.bai|cram\\.crai)$"
        },
        {
          "exampleName": "preprocessing/markduplicates/SampleName/SampleName.md.bam",
          "description": "Duplicate-marked alignments (BAM/CRAM)",
          "sampleMatchingPattern": "preprocessing/(?P<bamType>markduplicates|sentieon_dedup)/(?P<sampleName>[^/]+)/[^/]+\\.(?:bam|cram)$"
        },
        {
          "exampleName": "preprocessing/markduplicates/SampleName/SampleName.md.bam.bai",
          "description": "Duplicate-marked alignments (BAM/CRAM Index)",
          "sampleMatchingPattern": "preprocessing/(?P<bamType>markduplicates|sentieon_dedup)/(?P<sampleName>[^/]+)/[^/]+\\.(?:bam\\.bai|cram\\.crai)$"
        },
        {
          "exampleName": "preprocessing/mapped/SampleName/SampleName.sorted.bam",
          "description": "Aligned reads (BAM/CRAM)",
          "sampleMatchingPattern": "preprocessing/(?P<bamType>[^/]+)/(?P<sampleName>[^/]+)/[^/]+\\.(?:bam|cram)$"
        },
        {
          "exampleName": "preprocessing/mapped/SampleName/SampleName.sorted.bam.bai",
          "description": "Aligned reads (BAM/CRAM Index)",
          "sampleMatchingPattern": "preprocessing/(?P<bamType>[^/]+)/(?P<sampleName>[^/]+)/[^/]+\\.(?:bam\\.bai|cram\\.crai)$"
        }
      ]
    }
  ]
}
