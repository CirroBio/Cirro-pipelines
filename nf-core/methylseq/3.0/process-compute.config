profiles {
    standard {
        process {
            errorStrategy = 'retry'
            maxRetries = 2
        }
    }
}

// Only runs when `use_gpu` is selected in the form. The module carries the
// `process_gpu` label but methylseq never sets `accelerator` for it, so the
// request is made here.
process {
    withName: PARABRICKS_FQ2BAMMETH {
        accelerator = 1
        // Use On-Demand GPU queue for a GPU task that should not be interrupted
        queue       = env('PW_GPU_ONDEMAND_JOB_QUEUE')
    }
}

manifest {
    nextflowVersion = '>=24.04.0'
}