profiles {
    standard {
        process {
            errorStrategy = 'retry'
            maxRetries = 2

            // Keeps retries schedulable as resources scale with task.attempt
            resourceLimits = [ cpus: 64, memory: 488.GB ]

            // Genome indexes are only built when no prebuilt one exists. BWA-MEM2
            // (use_mem2) indexes the doubled C->T / G->A genome in about 150 GB.
            withName: 'BWAMETH_INDEX' {
                cpus   = { 24     * task.attempt }
                memory = { 192.GB * task.attempt }
                time   = { 24.h   * task.attempt }
                queue  = env('PW_ONDEMAND_JOB_QUEUE')
            }
            withName: 'BISMARK_GENOMEPREPARATION' {
                cpus   = { 16     * task.attempt }
                memory = { 128.GB * task.attempt }
                time   = { 24.h   * task.attempt }
                queue  = env('PW_ONDEMAND_JOB_QUEUE')
            }

            // Samples with more than 10 GB of input (about 100M read pairs of gzipped
            // FASTQ) run large and On-Demand, so multi-day jobs are not lost to Spot
            // reclaims. Smaller samples keep the pipeline's process_high resources on
            // Spot. Time limits are the pipeline's own or longer.
            withName: 'BWAMETH_ALIGN' {
                cpus   = { (reads*.size().sum() > 10.GB.toBytes() ? 48 : 12) * task.attempt }
                memory = { (reads*.size().sum() > 10.GB.toBytes() ? 192.GB : 72.GB) * task.attempt }
                time   = { 6.d * task.attempt }
                queue  = { reads*.size().sum() > 10.GB.toBytes() ? env('PW_ONDEMAND_JOB_QUEUE') : env('PW_SPOT_JOB_QUEUE') }
            }
            // Bismark sets --multicore to min(cpus / 3, memory / 13 GB) for directional
            // libraries, so 48 CPUs and 192 GB give 14 parallel instances.
            withName: 'BISMARK_ALIGN' {
                cpus   = { (reads*.size().sum() > 10.GB.toBytes() ? 48 : 12) * task.attempt }
                memory = { (reads*.size().sum() > 10.GB.toBytes() ? 192.GB : 72.GB) * task.attempt }
                time   = { 8.d * task.attempt }
                queue  = { reads*.size().sum() > 10.GB.toBytes() ? env('PW_ONDEMAND_JOB_QUEUE') : env('PW_SPOT_JOB_QUEUE') }
            }
            withName: 'BISMARK_DEDUPLICATE' {
                time   = { 2.d * task.attempt }
                queue  = { bam.size() > 10.GB.toBytes() ? env('PW_ONDEMAND_JOB_QUEUE') : env('PW_SPOT_JOB_QUEUE') }
            }
            withName: 'BISMARK_METHYLATIONEXTRACTOR' {
                time   = { 2.d * task.attempt }
                queue  = { bam.size() > 10.GB.toBytes() ? env('PW_ONDEMAND_JOB_QUEUE') : env('PW_SPOT_JOB_QUEUE') }
            }
        }
    }
}
