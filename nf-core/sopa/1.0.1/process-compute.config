// Compute configuration for nf-core/sopa 1.0.1.
// Executor, queue and instance sizing come from the Cirro compute environment chosen
// at launch; the workflow's own config declares per-process cpu and memory requests.

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries = 2
}

// sopa's manifest strictly pins Nextflow '!>=25.10.4', but the pipeline runs
// correctly on Cirro's default engine (all tasks completed under a newer engine,
// and no >=25.10-only syntax is used). Cirro's post-run transform stage cannot
// parse its own config under Nextflow >=25.10, so instead of pinning the engine
// up, relax the manifest requirement; this override is merged after the
// workflow's own config and takes precedence.
manifest.nextflowVersion = '>=24.10.0'
