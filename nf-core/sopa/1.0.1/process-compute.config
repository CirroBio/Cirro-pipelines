// Compute configuration for nf-core/sopa 1.0.1.
// Executor, queue and instance sizing come from the Cirro compute environment chosen
// at launch; the workflow's own config declares per-process cpu and memory requests.

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries = 2

    // process_medium's 36 GB is killed (exit 137) on a 7 GB Xenium region and its
    // 72 GB retry succeeds, so start at the size that works
    withName: 'MAKE_TRANSCRIPT_PATCHES' {
        memory = { 72.GB * task.attempt }
    }

    // The module has no `process_gpu` label -- `cellpose_use_gpu` only passes a
    // flag to the sopa CLI -- so the GPU request and queue are switched on the
    // param here. Without it the task stays on the default SPOT queue.
    withName: 'PATCH_SEGMENTATION_CELLPOSE' {
        accelerator = params.cellpose_use_gpu ? 1 : null
        // Use dedicated GPU queue (doesn't share resources with default SPOT queue)
        queue       = params.cellpose_use_gpu ? env('PW_GPU_JOB_QUEUE') : env('PW_SPOT_JOB_QUEUE')
    }
}
