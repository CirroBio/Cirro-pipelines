{
  "ui": {},
  "form": {
    "title": "De novo bacterial assembly and annotation (nf-core/bacass)",
    "type": "object",
    "required": ["input"],
    "properties": {
      "input": {
        "type": "string",
        "schema": "pipeline_samplesheet"
      },
      "assembler": {
        "type": "object",
        "title": "Assembly",
        "properties": {
          "assembler": {
            "type": "string",
            "title": "Assembler",
            "description": "Tool used for de novo assembly",
            "enum": [
              "unicycler",
              "canu",
              "miniasm"
            ],
            "default": "unicycler"
          }
        },
        "dependencies": {
          "assembler": {
            "oneOf": [
              {
                "properties": {
                  "assembler": {
                    "enum": ["unicycler"]
                  },
                  "unicycler_mode": {
                    "type": "string",
                    "title": "Unicycler mode",
                    "description": "Mode used by Unicycler for genome assembly",
                    "enum": [
                      "conservative",
                      "normal",
                      "bold"
                    ],
                    "default": "normal"
                  }
                }
              },
              {
                "properties": {
                  "assembler": {
                    "enum": ["canu"]
                  },
                  "canu_mode": {
                    "type": "string",
                    "title": "Canu mode",
                    "description": "Mode used by Canu for genome assembly",
                    "enum": [
                      "-nanopore",
                      "-pacbio",
                      "-pacbio-hifi"
                    ],
                    "enumNames": [
                      "Nanopore",
                      "PacBio",
                      "PacBio HiFi"
                    ],
                    "default": "-nanopore"
                  }
                }
              },
              {
                "properties": {
                  "assembler": {
                    "enum": ["miniasm"]
                  }
                }
              }
            ]
          }
        }
      },
      "annotation": {
        "type": "object",
        "title": "Annotation",
        "properties": {
          "annotation_tool": {
            "type": "string",
            "title": "Annotation tool",
            "description": "Tool used to annotate the assembly",
            "enum": [
              "prokka",
              "bakta",
              "dfast"
            ],
            "default": "prokka"
          }
        }
      },
      "skip_kraken2": {
        "type": "boolean",
        "title": "Skip Kraken2",
        "description": "Skip running Kraken2 taxonomic classifier on reads",
        "default": false
      },
      "skip_annotation": {
        "type": "boolean",
        "title": "Skip Annotation",
        "description": "Skip annotating the assembly with Prokka",
        "default": false
      }
    }
  },
  "structuredInputs": {
    "pipeline_samplesheet": {
      "fileFormat": "TSV",
      "schema": {
        "title": "Samplesheet",
        "description": "One row per sample, with all of its long reads in a single gzipped FASTQ file.",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "ID": {
              "type": "string",
              "title": "Sample",
              "pattern": "^\\S+$",
              "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "LongFastQ": {
              "type": "string",
              "format": "file-path",
              "title": "Long-read FASTQ",
              "pattern": "^(?![\\S\\s]*_I[12]_001\\.f(ast)?q\\.gz$)([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
              "errorMessage": "Must be a gzipped read FASTQ (.fastq.gz or .fq.gz) with no spaces in its name, not an I1/I2 index read"
            },
            "GenomeSize": {
              "type": "string",
              "title": "Genome size",
              "description": "Estimated genome size in megabases, such as 2.8m. Required when the assembler is Canu",
              "pattern": "^\\d+\\.\\d+m$",
              "errorMessage": "Must be a number of megabases with a decimal point, followed by m (such as 2.8m or 5.0m)"
            }
          },
          "required": ["ID", "LongFastQ"]
        }
      }
    }
  }
}
