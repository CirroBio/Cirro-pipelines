profiles {
    standard {
        process {
            errorStrategy = 'retry'
            maxRetries = 5
        }
    }
}

params{
    tools = null
    pon = null
    vep_dbnsfp = false
    vep_loftee = false
    vep_spliceai = false
    vep_spliceregion = false
    genome = null

    max_memory                 = 488.GB
    max_cpus                   = 64
    max_time                   = 240.h
}

process{
    // Native Nextflow resource capping (24.x+), replacing the community
    // check_max() helper pattern -- a bare `def function(){}` declaration at
    // the top of a config file parses under older Nextflow but is rejected
    // outright by Nextflow 26.x's stricter config grammar ("Unexpected
    // input: '('"). resourceLimits caps every declared cpus/memory/time
    // below without needing a helper function at all.
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    withLabel:process_low {
        cpus         = { 2 * task.attempt }
        memory       = { 15.GB * task.attempt }
        time         = { 24.h * task.attempt }
    }
    withLabel:process_medium {
        cpus         = { 4 * task.attempt }
        memory       = { 30.GB * task.attempt }
        time         = { 24.h * task.attempt }
    }
    withLabel:process_high {
        cpus         = { 8 * task.attempt }
        memory       = { 60.GB * task.attempt }
        time         = { 24.h * task.attempt }
    }
    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus         = { 16 * task.attempt }
        memory       = { 120.GB * task.attempt }
        time         = { 24.h * task.attempt }
    }
    withName:'GATK4_APPLYBQSR|GATK4_APPLYBQSR_SPARK|GATK4_BASERECALIBRATOR|SAMTOOLS_STATS'{
        cpus         = { 2 * task.attempt }
        memory       = { 16.GB * task.attempt }
        time         = { 24.h * task.attempt }
    }
    withName:'GATK4_APPLYBQSR|GATK4_APPLYBQSR_SPARK|GATK4_BASERECALIBRATOR|GATK4_GATHERBQSRREPORTS'{
        cpus         = { 2 * task.attempt }
        memory       = { 16.GB * task.attempt }
        time         = { 24.h * task.attempt }
    }
    withName: 'GATK4_MARKDUPLICATES'{
        cpus         = { 16 * task.attempt }
        memory       = { 120.GB * task.attempt }
        time         = { 48.h * task.attempt }
    }
    withName: 'FREEBAYES|SAMTOOLS_STATS|SAMTOOLS_INDEX|UNZIP' {
        cpus         = { 4 * task.attempt }
        memory       = { 30.GB * task.attempt }
        time         = { 24.h * task.attempt }
    }
}

docker.registry       = 'quay.io'
apptainer.registry  = 'quay.io'
